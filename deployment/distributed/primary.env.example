# Primary node: API, generation, vision, Feishu and Gradio
# ollama keeps inference local; openai uses OPENAI_API_KEY from the private .env.
LLM_PROVIDER=ollama
OLLAMA_MODEL=enbot-v9:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_GPU=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

RETRIEVAL_MODE=remote
RETRIEVAL_API_URL=http://192.168.1.120:8100
RETRIEVAL_API_KEY=replace-with-the-same-long-random-secret
RETRIEVAL_TIMEOUT_SECONDS=8
RETRIEVAL_LOCAL_FALLBACK=false

ENBOT_EAGER_LOAD=true
ENBOT_MAX_CONCURRENCY=1