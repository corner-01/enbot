# Retrieval GPU node: embedding, Milvus, BM25, RRF and reranking
RETRIEVAL_MODE=local
RETRIEVAL_API_KEY=replace-with-the-same-long-random-secret
RETRIEVAL_EAGER_LOAD=true
RETRIEVAL_EAGER_WARMUP=true
RETRIEVAL_MAX_CONCURRENCY=1
CUDA_VISIBLE_DEVICES=0

KNOWLEDGE_FILE=./knowledge_data
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=enbot_knowledge_v1
EMBEDDING_MODEL_PATH=./models/Qwen3-8B-native
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=4
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_ENABLED=true

RAG_DENSE_K=30
RAG_LEXICAL_K=20
RAG_RERANK_K=5
RAG_FINAL_K=2
RAG_RRF_K=80
RAG_DENSE_WEIGHT=0.5
RAG_LEXICAL_WEIGHT=1.5
RAG_RERANK_RELATIVE_THRESHOLD=0.6
RAG_RERANK_ABSOLUTE_THRESHOLD=0.1
RAG_RERANK_MIN_SCORE=0.03

