# enbot runtime configuration
# Keep ollama for the local EnBot-V9 model; set openai for OpenAI or a
# compatible API gateway. The frontend continues using the same EnBot API.
LLM_PROVIDER=ollama
# Public web search is opt-in. Keep false for grounded production answers.
ENBOT_WEB_SEARCH_ENABLED=false

# Local Ollama provider
OLLAMA_MODEL=enbot-v9:7b
# Empty = Ollama automatic GPU placement; use 0 when a 16 GB GPU is reserved for the 8B embedding model.
OLLAMA_NUM_GPU=
# true: answer with the configured model only; do not initialize RAG or Agent tools.
ENBOT_MODEL_ONLY=false
# Optional RAG-only switch. ENBOT_MODEL_ONLY implies this automatically.
ENBOT_DISABLE_RAG=false

# Distributed retrieval. Keep local for one machine; use remote on the primary
# node when a dedicated retrieval GPU node is available.
RETRIEVAL_MODE=local
RETRIEVAL_API_URL=http://127.0.0.1:8100
RETRIEVAL_API_KEY=
RETRIEVAL_TIMEOUT_SECONDS=8
RETRIEVAL_LOCAL_FALLBACK=false

# Production API service
# Keep 127.0.0.1 when using an SSH tunnel or reverse proxy. Use 0.0.0.0 only
# inside a protected server network and set ENBOT_API_KEY.
ENBOT_API_HOST=0.0.0.0
ENBOT_API_PORT=8000
ENBOT_API_KEY=
ENBOT_EAGER_LOAD=true
ENBOT_MAX_CONCURRENCY=1
ENBOT_MAX_SESSIONS=64
ENBOT_REQUIRE_MILVUS=true
ENBOT_ENABLE_DEBUG=false
ENBOT_ENABLE_EVALUATION=false
# Comma-separated browser origins. Add `null` only for a local file:// demo page.
ENBOT_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# SSE 传输参数：RAG 运行期间的心跳间隔，以及回答分片的字符数。
ENBOT_SSE_HEARTBEAT_SECONDS=10
ENBOT_SSE_CHUNK_CHARS=24
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI provider. Keep OPENAI_BASE_URL blank for the official OpenAI API.
# Never expose OPENAI_API_KEY to the frontend or commit it to Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
ENBOT_FEEDBACK_ENABLED=true
ENBOT_FEEDBACK_DB_PATH=./data/feedback/enbot_feedback.db

# MCP adapter. It reuses the API above and does not load another model.
ENBOT_MCP_API_BASE_URL=http://127.0.0.1:8000
ENBOT_MCP_API_KEY=
ENBOT_MCP_TIMEOUT_SECONDS=300
ENBOT_MCP_TRANSPORT=stdio
ENBOT_MCP_HOST=127.0.0.1
ENBOT_MCP_PORT=8020

# Keep framework caches inside this project (and therefore on the same disk as the repository).
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface/transformers
TORCH_HOME=./.cache/torch

# Local knowledge base and vector database
KNOWLEDGE_FILE=./knowledge_data
# Milvus is the only supported vector-store backend.
VECTOR_STORE=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=enbot_knowledge_v1
MILVUS_CONSISTENCY_LEVEL=Session
MILVUS_INSERT_BATCH_SIZE=32

# Retrieval and chunking controls
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_PARENT_FULL_MAX_CHARS=12000
RAG_DENSE_K=30
RAG_LEXICAL_K=20
RAG_RERANK_K=5
RAG_FINAL_K=2
RAG_RRF_K=80
RAG_DENSE_WEIGHT=0.5
RAG_LEXICAL_WEIGHT=1.5
RAG_RERANK_RELATIVE_THRESHOLD=0.6
RAG_RERANK_ABSOLUTE_THRESHOLD=0.1
RAG_RERANK_MIN_SCORE=0.03
RAG_RERANK_TIE_EPSILON=0.0001
EMBEDDING_BATCH_SIZE=4

# Local embedding and reranker models
EMBEDDING_MODEL_PATH=./models/Qwen3-8B-native
EMBEDDING_DEVICE=cuda
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_DEVICE=cpu

# Disable RAGAS telemetry; evaluation remains local
RAGAS_DO_NOT_TRACK=true

# Feishu bot (official SDK long connection)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# rag = EnBot /chat with retrieval; ollama = fine-tuned model only, without RAG.
FEISHU_BACKEND=rag
ENBOT_API_URL=http://127.0.0.1:8000/chat
FEISHU_OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
FEISHU_OLLAMA_MODEL=enbot-v9:7b
FEISHU_ENBOT_TIMEOUT=300
FEISHU_QUEUE_SIZE=16
FEISHU_MAX_REPLY_CHARS=3500
FEISHU_FEEDBACK_ENABLED=true
# Forward Feishu image messages to the separately running multimodal service.
FEISHU_VISION_ENABLED=true
FEISHU_VISION_API_URL=http://127.0.0.1:8011/v1/diagnose
FEISHU_VISION_TIMEOUT=300
FEISHU_VISION_MAX_IMAGE_MIB=10
FEISHU_VISION_QUESTION=请识别图片中的设备、故障或告警信息，并给出有依据的排查建议。
# Shared by the vision API server and the Feishu bridge; leave empty for local-only use.
VISION_API_KEY=
# In group chats, only answer messages that mention the bot. Private chats always work.
FEISHU_REQUIRE_GROUP_MENTION=true
# Optional comma-separated chat ID allowlist. Empty means all chats are allowed.
FEISHU_ALLOWED_CHAT_IDS=
# Usually not required for long connection. Keep empty unless Feishu is configured with them.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_LOG_LEVEL=INFO
