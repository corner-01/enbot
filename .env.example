# enbot runtime configuration
OLLAMA_MODEL=enbot-optuna:7b
# Empty = Ollama automatic GPU placement; use 0 when a 16 GB GPU is reserved for the 8B embedding model.
OLLAMA_NUM_GPU=

# Production API service
# Keep 127.0.0.1 when using an SSH tunnel or reverse proxy. Use 0.0.0.0 only
# inside a protected server network and set ENBOT_API_KEY.
ENBOT_API_HOST=127.0.0.1
ENBOT_API_PORT=8000
ENBOT_API_KEY=
ENBOT_EAGER_LOAD=true
ENBOT_MAX_CONCURRENCY=1
ENBOT_MAX_SESSIONS=64
ENBOT_REQUIRE_MILVUS=true
ENBOT_ENABLE_DEBUG=false
ENBOT_ENABLE_EVALUATION=false
ENBOT_CORS_ORIGINS=
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENBOT_FEEDBACK_ENABLED=true
ENBOT_FEEDBACK_DB_PATH=./data/feedback/enbot_feedback.db

# Keep framework caches inside this project (and therefore on the same disk as the repository).
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface/transformers
TORCH_HOME=./.cache/torch

# Local knowledge base and vector database
KNOWLEDGE_FILE=./knowledge_data
# Milvus is the only supported vector-store backend.
VECTOR_STORE=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=enbot_knowledge_v1
MILVUS_CONSISTENCY_LEVEL=Session
MILVUS_INSERT_BATCH_SIZE=32

# Retrieval and chunking controls
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_PARENT_FULL_MAX_CHARS=12000
RAG_DENSE_K=30
RAG_LEXICAL_K=20
RAG_RERANK_K=5
RAG_FINAL_K=2
RAG_RRF_K=80
RAG_DENSE_WEIGHT=0.5
RAG_LEXICAL_WEIGHT=1.5
RAG_RERANK_RELATIVE_THRESHOLD=0.6
RAG_RERANK_ABSOLUTE_THRESHOLD=0.1
RAG_RERANK_MIN_SCORE=0.03
RAG_RERANK_TIE_EPSILON=0.0001
EMBEDDING_BATCH_SIZE=4

# Local embedding and reranker models
EMBEDDING_MODEL_PATH=./models/Qwen3-8B-native
EMBEDDING_DEVICE=cuda
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANKER_ENABLED=true

# Disable RAGAS telemetry; evaluation remains local
RAGAS_DO_NOT_TRACK=true

# Feishu bot (official SDK long connection)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# rag = EnBot /chat with retrieval; ollama = fine-tuned model only, without RAG.
FEISHU_BACKEND=rag
ENBOT_API_URL=http://127.0.0.1:8000/chat
FEISHU_OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
FEISHU_OLLAMA_MODEL=enbot-optuna:7b
FEISHU_ENBOT_TIMEOUT=300
FEISHU_QUEUE_SIZE=16
FEISHU_MAX_REPLY_CHARS=3500
FEISHU_FEEDBACK_ENABLED=true
# In group chats, only answer messages that mention the bot. Private chats always work.
FEISHU_REQUIRE_GROUP_MENTION=true
# Optional comma-separated chat ID allowlist. Empty means all chats are allowed.
FEISHU_ALLOWED_CHAT_IDS=
# Usually not required for long connection. Keep empty unless Feishu is configured with them.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_LOG_LEVEL=INFO
